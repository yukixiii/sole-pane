{
  "name": "sole-pane",
  "version": "0.1.0",
  "description": "Close every split except the focused one, keeping all of its tabs, like Vim's Ctrl+W o.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": ["obsidian", "plugin", "vim", "split", "pane"],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "tslib": "^2.6.0",
    "typescript": "^5.6.0"
  }
}
